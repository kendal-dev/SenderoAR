# =============================================================
# 3D ASSETS - Raw Capture Files (HUGE)
# =============================================================
# Videos crudos de captura (10+ GB cada uno)
*.mp4
*.mov
*.MP4
*.MOV
!Assets/**/*.mp4
!Assets/**/*.mov

# RealityCapture project files
*.rcproj
*.rcalign
*.rcbox

# Blender backup files
*.blend1
*.blend2
*.blend@

# High-poly meshes (pre-optimización)
*_highpoly.fbx
*_highpoly.obj
*_raw.fbx

# Capturas RAW de cámara
*.dng
*.raw
*.cr2
*.nef

